{
  "name": "slopticus-relay",
  "version": "0.16.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "build": "tsc && vite build",
    "start": "node dist/server.js",
    "check": "tsc --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.test.json && npm run lint",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "prettier --check src web test *.json *.ts *.md docs",
    "format": "prettier --write src web test *.json *.ts *.md docs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.21.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.0"
  }
}
